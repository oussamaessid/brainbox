rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Classements écrits directement par l'app, sans Firebase Auth (plan gratuit Spark).
    // Un document par joueur et par classement :
    // leaderboards/{day|week|month}_{FR|EN|AR|ALL}_{période}/entries/{uuid du joueur}.
    // ALL = les trois langues additionnées.
    match /leaderboards/{board}/entries/{playerId} {
      allow read: if true;
      allow create, update: if validBoard(board)
        && playerId.matches('^[0-9a-f-]{36}$')
        && validEntry(request.resource.data, board)
        // Un score ne baisse jamais ; à score égal, seul le profil (pseudo / avatar) peut changer.
        && (resource == null
          || request.resource.data.score > resource.data.score
          || (request.resource.data.score == resource.data.score
            && request.resource.data.wins == resource.data.wins));
      allow delete: if false;
    }
    // Couples pseudo + avatar uniques : names/{hex du pseudo en minuscules}_{avatar} -> uuid du joueur.
    // Le même pseudo reste libre avec un autre avatar ; une fois réservé, un couple ne change plus de propriétaire.
    match /names/{key} {
      allow read: if true;
      allow create: if validName(request.resource.data) && validKey(key, request.resource.data);
      allow update: if validName(request.resource.data) && validKey(key, request.resource.data)
        && request.resource.data.playerId == resource.data.playerId;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }

    function validName(data) {
      return data.keys().hasOnly(['name', 'avatar', 'playerId', 'updatedAt'])
        && data.keys().hasAll(['name', 'avatar', 'playerId', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 24
        && data.avatar is int && data.avatar >= 0 && data.avatar < 56
        && data.playerId is string && data.playerId.matches('^[0-9a-f-]{36}$')
        && data.updatedAt == request.time;
    }
    function validKey(key, data) {
      return key.matches('^[0-9a-f]{4,192}_' + string(data.avatar) + '$');
    }

    function validBoard(board) {
      return board.matches('^day_(FR|EN|AR|ALL)_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        || board.matches('^week_(FR|EN|AR|ALL)_[0-9]{4}-W[0-9]{2}$')
        || board.matches('^month_(FR|EN|AR|ALL)_[0-9]{4}-[0-9]{2}$');
    }
    // Un défi par langue et par jour : 1 / 7 / 31 victoires par langue, trois fois plus pour ALL.
    function maxWins(board) {
      let base = board.matches('^day_.*') ? 1 : (board.matches('^week_.*') ? 7 : 31);
      return board.matches('^[a-z]+_ALL_.*') ? base * 3 : base;
    }
    // Une victoire rapporte de 10 à 100 points.
    function validEntry(data, board) {
      return data.keys().hasOnly(['name', 'avatar', 'score', 'wins', 'updatedAt'])
        && data.keys().hasAll(['name', 'avatar', 'score', 'wins', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 24
        && data.avatar is int && data.avatar >= 0 && data.avatar < 56
        && data.wins is int && data.wins >= 1 && data.wins <= maxWins(board)
        && data.score is int && data.score >= data.wins * 10 && data.score <= data.wins * 100
        && data.updatedAt == request.time;
    }
  }
}
